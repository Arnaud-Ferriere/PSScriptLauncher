<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Keyboard shortcuts" Width="540" Height="440" MinWidth="420" MinHeight="320"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="13">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock x:Name="ShortcutsHint" TextWrapping="Wrap" Margin="0,0,0,10"/>

    <Grid Grid.Row="1" Margin="6,0,0,4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="160"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="KeysHeader" Grid.Column="0" FontWeight="SemiBold"/>
      <TextBlock x:Name="ActionHeader" Grid.Column="1" FontWeight="SemiBold"/>
    </Grid>

    <!-- A real list: each row is one item, announced as "keys, action", browsable with the
         arrows and the page keys instead of a wall of loose text blocks. -->
    <ListBox x:Name="ShortcutsList" Grid.Row="2" HorizontalContentAlignment="Stretch"
             Background="{DynamicResource ListBrush}" BorderBrush="{DynamicResource BorderBrush}"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem">
          <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}"/>
          <Setter Property="Padding" Value="2,4"/>
        </Style>
      </ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="160"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding Keys}" FontFamily="Consolas, Segoe UI"
                       FontWeight="SemiBold" Foreground="{DynamicResource KeyBrush}" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center"/>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <Button x:Name="ShortcutsCloseButton" Grid.Row="3" HorizontalAlignment="Right" Padding="18,4"
            Margin="0,12,0,0" IsCancel="True"/>
  </Grid>
</Window>

<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lanceur de scripts" Width="1180" Height="780" MinWidth="900" MinHeight="540"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13">
  <Grid Margin="10">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="320" MinWidth="220"/>
      <ColumnDefinition Width="8"/>
      <ColumnDefinition Width="*" MinWidth="560"/>
    </Grid.ColumnDefinitions>

    <DockPanel Grid.Column="0">
      <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
        <TextBox x:Name="SearchBox" Padding="6,4" VerticalContentAlignment="Center"/>
        <TextBlock x:Name="SearchHint" Text="Rechercher (nom, dossier, synopsis)   Ctrl+F" Foreground="Gray"
                   Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
      </Grid>
      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
        <Button x:Name="FolderButton" DockPanel.Dock="Right" Content="Dossier..." Padding="10,3" Margin="6,0,0,0"
                ToolTip="Changer le dossier analysé (Ctrl+O)"/>
        <TextBlock x:Name="RootText" VerticalAlignment="Center" Foreground="Gray"
                   TextTrimming="CharacterEllipsis"/>
      </DockPanel>
      <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
        <Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="Actualiser (F5)" Padding="10,3" Margin="6,0,0,0"/>
        <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="Gray" TextTrimming="CharacterEllipsis"/>
      </DockPanel>
      <ProgressBar x:Name="ScanProgress" DockPanel.Dock="Bottom" Height="4" Margin="0,6,0,0" Visibility="Collapsed"/>
      <TreeView x:Name="ScriptTree" Padding="2,4"/>
    </DockPanel>

    <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                  ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="Transparent"/>

    <Grid Grid.Column="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Margin="2,0,0,8">
        <DockPanel>
          <Button x:Name="FavoriteButton" DockPanel.Dock="Right" Content="☆ Favori" Padding="10,3"
                  VerticalAlignment="Center" IsEnabled="False"/>
          <TextBlock x:Name="ScriptTitle" Text="Sélectionnez un script" FontSize="20" FontWeight="SemiBold"
                     TextTrimming="CharacterEllipsis"/>
        </DockPanel>
        <TextBlock x:Name="ScriptPath" Foreground="Gray" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
        <TextBlock x:Name="ScriptSynopsis" TextWrapping="Wrap" Margin="0,8,0,0"/>
        <TextBlock x:Name="ScriptInfo" TextWrapping="Wrap" Foreground="SteelBlue" Margin="0,6,0,0"
                   Visibility="Collapsed"/>
        <TextBlock x:Name="ScriptWarning" TextWrapping="Wrap" Foreground="DarkOrange" Margin="0,4,0,0"
                   Visibility="Collapsed"/>
      </StackPanel>

      <TabControl x:Name="DetailTabs" Grid.Row="1">
        <TabItem Header="Paramètres">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="10,10,16,10">
              <Border x:Name="DescriptionPanel" BorderBrush="LightGray" BorderThickness="0,0,0,1"
                      Padding="0,0,0,10" Margin="0,0,0,14" Visibility="Collapsed">
                <TextBlock x:Name="ScriptDescription" TextWrapping="Wrap" Foreground="DimGray"/>
              </Border>
              <StackPanel x:Name="SetPanel" Orientation="Horizontal" Margin="0,0,0,14" Visibility="Collapsed">
                <TextBlock Text="Jeu de paramètres :" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="SetCombo" MinWidth="220"/>
              </StackPanel>
              <StackPanel x:Name="ExamplePanel" Orientation="Horizontal" Margin="0,0,0,14" Visibility="Collapsed">
                <TextBlock Text="Exemple :" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="ExampleCombo" MinWidth="220" MaxWidth="560"/>
              </StackPanel>
              <StackPanel x:Name="ParamPanel"/>
              <Border BorderBrush="LightGray" BorderThickness="0,1,0,0" Margin="0,4,0,0" Padding="0,10,0,0">
                <StackPanel>
                  <WrapPanel>
                    <CheckBox x:Name="VerboseCheck" Content="-Verbose" Margin="0,0,18,8" Visibility="Collapsed"/>
                    <CheckBox x:Name="WhatIfCheck" Content="-WhatIf (simulation, sans modification)"
                              Margin="0,0,18,8" Visibility="Collapsed"/>
                  </WrapPanel>
                  <TextBlock Text="Arguments supplémentaires (ajoutés tels quels)" Foreground="Gray" Margin="0,0,0,3"/>
                  <TextBox x:Name="ExtraArgsBox" FontFamily="Consolas" Padding="4,3"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="Aide">
          <TextBox x:Name="HelpText" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" BorderThickness="0"
                   Padding="10" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/>
        </TabItem>
      </TabControl>

      <StackPanel Grid.Row="2" Margin="0,10,0,0">
        <TextBlock Text="Commande" FontWeight="SemiBold" Margin="0,0,0,3"/>
        <TextBox x:Name="CommandBox" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" Padding="6,4"
                 MinHeight="46" MaxHeight="120" VerticalScrollBarVisibility="Auto"/>
        <Grid Margin="0,8,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <WrapPanel Grid.Column="0" VerticalAlignment="Center">
            <TextBlock Text="Moteur :" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="EngineCombo" MinWidth="190" Margin="0,2,14,2" VerticalAlignment="Center"/>
            <CheckBox x:Name="NoExitCheck" Content="Garder la console ouverte" IsChecked="True"
                      VerticalAlignment="Center" Margin="0,2,14,2"/>
            <CheckBox x:Name="NoProfileCheck" Content="Sans profil" IsChecked="True"
                      VerticalAlignment="Center" Margin="0,2,14,2"/>
            <CheckBox x:Name="ElevateCheck" Content="En administrateur" VerticalAlignment="Center" Margin="0,2,14,2"/>
          </WrapPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="ResetButton" Content="Effacer la saisie" Padding="10,4" Margin="0,0,6,0" IsEnabled="False"/>
            <Button x:Name="LocateButton" Content="Emplacement" Padding="10,4" Margin="0,0,6,0" IsEnabled="False"/>
            <Button x:Name="CopyButton" Content="Copier" Padding="10,4" Margin="0,0,6,0" IsEnabled="False"/>
            <Button x:Name="RunButton" Content="Lancer" Padding="22,4" FontWeight="SemiBold" IsEnabled="False"/>
          </StackPanel>
        </Grid>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
